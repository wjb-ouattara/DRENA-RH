/* ========================================================================
   PATCH — Sidebar en thème clair
   ========================================================================
   ATTENTION : ce fichier n'est PAS chargé par l'application. Son contenu a
   déjà été recopié en fin de ressources/styles/main.qss, qui est la seule
   feuille lue au démarrage (src/ui/app.py). Il est conservé à titre de
   référence et peut être supprimé sans effet.
   ======================================================================== */

QWidget#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #F1F5F9;
}

QWidget#sidebarHeader {
    background-color: transparent;
    border-bottom: 1px solid #FFEDD5;
}

QLabel#appLogo {
    color: #1C1917;
    background: transparent;
}

QLabel#appSubtitle {
    color: #78716C;
    background: transparent;
}

QLabel#sidebarFooter {
    color: #D6D3D1;
    background: transparent;
    border-top: 1px solid #FFEDD5;
}
