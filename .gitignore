# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/

# Fichiers .spec generes automatiquement par PyInstaller,
# SAUF main.spec qui est notre configuration de build maintenue a la main.
# (Sans cette exception, main.spec disparaissait du depot.)
*.spec
!main.spec

# Environnements virtuels
venv/
env/
ENV/
.venv

# ===== IDE =====
.vscode/
.idea/
.snowflake/
*.swp
*.swo
*~

# ===== Système =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Application =====
# Base de données locale (ne pas committer les données réelles)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/backups/*.db

# Documents générés (sortie de l'app)
output/*/

# Logs
logs/
*.log

# Fichiers temporaires
*.tmp
~$*

# ===== Tests =====
.pytest_cache/
.coverage
htmlcov/
