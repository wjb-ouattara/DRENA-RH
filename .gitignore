# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
# Le dossier dist/ est ignore, SAUF l'executable livre et sa notice : le client
# doit pouvoir telecharger l'application depuis le depot pour l'installer sur un
# autre poste, sans chaine de compilation.
# La regle s'ecrit « dist/* » et non « dist/ » : Git n'examine pas le contenu
# d'un dossier ignore, une exception « !dist/... » y serait donc sans effet.
dist/*
!dist/DRENAET-RH.exe
!dist/LISEZ-MOI.txt
build/

# Fichiers .spec generes automatiquement par PyInstaller,
# SAUF main.spec qui est notre configuration de build maintenue a la main.
# (Sans cette exception, main.spec disparaissait du depot.)
*.spec
!main.spec

# Environnements virtuels
venv/
env/
ENV/
.venv

# ===== IDE =====
.vscode/
.idea/
.snowflake/
*.swp
*.swo
*~

# ===== Système =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Application =====
# Base de données locale (ne pas committer les données réelles)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/backups/*.db

# Documents générés (sortie de l'app)
output/*/

# Logs
logs/
*.log

# Fichiers temporaires
*.tmp
~$*

# ===== Tests =====
.pytest_cache/
.coverage
htmlcov/
